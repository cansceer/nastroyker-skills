{
  "name": "tsk-market",
  "url": "https://tsk-market.ru/",
  "cms": "StroykerBox",
  "cmsDocs": "https://box7.nastroyker.ru/api/v1/docs/",
  "cmsDocsAlternative": "https://stroybaza-samara.ru/api/v1/docs/",
  "cmsDocsStatus": "not-accessible-in-creation-session",
  "designReference": null,
  "viewports": [
    {"name": "desktop", "width": 2550, "height": 1440, "mobile": false},
    {"name": "mobile-390", "width": 390, "height": 844, "mobile": true},
    {"name": "mobile-360", "width": 360, "height": 800, "mobile": true},
    {"name": "breakpoint-1279", "width": 1279, "height": 900, "mobile": false},
    {"name": "breakpoint-991", "width": 991, "height": 900, "mobile": false},
    {"name": "breakpoint-767", "width": 767, "height": 900, "mobile": false}
  ],
  "boundaryWidths": [1278, 1280, 990, 992, 766, 768, 1378, 1124, 1073, 1024, 1023, 915, 900, 885, 830, 630, 600, 575, 520, 510, 505, 500, 481, 480, 468, 450, 440, 410, 280],
  "browsersRequested": ["Microsoft Edge"],
  "browserPolicy": {"required": "msedge", "fallbackAllowed": false},
  "browserExecutable": null,
  "maxImageBytes": 300000,
  "maxButtonVariants": 3,
  "maxParagraphVariants": 3,
  "repeatedPages": {"samplesPerTemplate": 5, "pathPatterns": ["^/catalog/product/", "^/products?/", "^/news/[^/]+/?$", "^/articles/[^/]+/?$"]},
  "excludePaths": [],
  "seedPaths": [],
  "internalHosts": ["tsk-market.ru", "www.tsk-market.ru"],
  "absoluteUrlPolicy": {"internalHtml": "relative-only", "externalHtml": "requires-explicit-exception", "approvedExternalHosts": [], "metadata": "report-separately"},
  "inlineStylePolicy": "manual-inline-review; runtime-cms-exceptions-require-evidence",
  "forms": {"inputAllowed": true, "submitAllowed": false, "mutationsAllowed": false, "testAccountAvailable": false},
  "cmsBlocks": ["contacts", "account", "cart", "catalog", "forms", "header", "footer", "sliders"],
  "cmsPermissions": "unknown; do-not-invent",
  "approvedExceptions": [],
  "crawl": {"delayMs": 400, "navigationTimeoutMs": 30000, "maxScrollSteps": 100, "maxSitemapUrls": 10000},
  "mutationPathPatterns": ["(?:^|/)(?:logout|signout)(?:/|$)", "(?:cart|basket|order|checkout)[^?#]*(?:add|remove|delete|update|clear|create|submit)", "(?:^|/)(?:add|remove|delete|update|clear)[-_]?(?:to[-_]?)?(?:cart|basket)(?:/|$)", "[?&](?:action|operation|op)=(?:add|remove|delete|update|clear|create|submit|logout)", "[?&](?:add-to-cart|remove-from-cart|update_cart)="]
}
